{
  "name": "frankmoji-everywhere",
  "version": "1.0.0",
  "description": "Obsidian plugin that replaces standard emoji with FrankMoji, the emoji set by Frank Rausch.",
  "main": "main.js",
  "scripts": {
    "pack": "node tools/build-pack.mjs",
    "dev": "npm run pack && node esbuild.config.mjs",
    "build": "npm run pack && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "npm run pack && vitest run"
  },
  "keywords": [
    "obsidian",
    "emoji"
  ],
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "obsidian": "^1.13.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
